# =============================================================================
# .env.example — PLANTILLA. Cópiala a .env.local y rellena con valores reales.
#
#   cp .env.example .env.local
#
# NUNCA pongas aquí contraseñas, claves ni secretos reales: este archivo SÍ se
# versiona. El .env.local real está ignorado por .gitignore.
# =============================================================================

# ── Jerarquía de usuarios: credenciales de arranque ──────────────────────────
# Se usan UNA SOLA VEZ, al ejecutar `npm run bootstrap`, para crear el
# MEGAADMINISTRADOR si todavía no existe.
#
# La contraseña NO se guarda en la base de datos: se envía a Supabase Auth, que
# la almacena hasheada con bcrypt en auth.users.encrypted_password. En las
# tablas de la aplicación no hay ninguna columna de contraseña.
#
# MEGAADMIN_PASSWORD es una credencial de ARRANQUE, no una contraseña que se
# reimponga en cada despliegue: si el megaadministrador ya existe, el script no
# la toca. Cámbiala desde la aplicación y retira esta variable del entorno.
MEGAADMIN_USERNAME=
MEGAADMIN_EMAIL=
MEGAADMIN_PASSWORD=
MEGAADMIN_NOMBRE=
MEGAADMIN_APELLIDO=

# Administrador que hereda la cartera ya existente al activar el multi-tenant.
# El script le asigna todos los registros que aún no tienen propietario.
LEGACY_ADMIN_EMAIL=
LEGACY_ADMIN_PASSWORD=
LEGACY_ADMIN_USERNAME=
LEGACY_ADMIN_NOMBRE=
LEGACY_ADMIN_APELLIDO=
LEGACY_ADMIN_TELEFONO=
LEGACY_ADMIN_CEDULA=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: imprescindible para el panel del megaadministrador y para el
# bootstrap. NUNCA con prefijo NEXT_PUBLIC_ y nunca expuesta al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Base de datos (sólo scripts) ─────────────────────────────────────────────
DATABASE_URL=

# ── Twilio WhatsApp ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_MORA_TEMPLATE_SID=

# ── Resend (correo: restablecimiento de contraseña y notificaciones) ─────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Otros ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
CRON_SECRET=
